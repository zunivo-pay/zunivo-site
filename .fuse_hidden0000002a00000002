/* scroll reveal */
(function(){
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.rv').forEach((el,i)=>{el.style.transitionDelay=(i%3*80)+'ms';io.observe(el)});
})();

/* terminal typewriter loop */
(function(){
  const lines=[
    ['c-cmd','$ curl https://api.example.dev/v1/index/crypto'],
    ['c-warn','402 Payment Required · 0.05 USDC · order <i class="c-id">9b4e3c4b</i>'],
    ['c-cmd','agent — paying 0.05 USDC on Arc… <i class="c-ok">✓ settled</i>'],
    ['c-cmd','$ curl -H "X-Zunivo-Order: 9b4e3c4b" https://api.example.dev/v1/index/crypto'],
    ['c-ok','200 OK — data delivered · receipt on-chain']
  ];
  const body=document.getElementById('termBody');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced){body.innerHTML=lines.map(l=>'<div class="'+l[0]+'">'+l[1]+'</div>').join('');return}
  let li=0,ci=0,cur,row;
  function newline(){const d=document.createElement('div');d.className=lines[li][0];body.insertBefore(d,cur);return d}
  function start(){body.innerHTML='<span class="cursor"></span>';cur=body.querySelector('.cursor');li=0;ci=0;row=newline();type()}
  function type(){
    const plain=lines[li][1].replace(/<[^>]*>/g,'');
    if(ci<=plain.length){row.textContent=plain.slice(0,ci);ci++;setTimeout(type,ci<3?280:15+Math.random()*24)}
    else{row.innerHTML=lines[li][1];li++;ci=0;
      if(li<lines.length){row=newline();setTimeout(type,400)}
      else setTimeout(start,5200)}
  }
  start();
})();
</script>
